# URL base da sua instância Zammad (sem barra final)
ZAMMAD_URL=https://seu-zammad.empresa.com.br

# Token de API do Zammad (Settings → API → Token Access)
ZAMMAD_TOKEN=seu_token_aqui

# Rate limiter — ajuste conforme o plano da sua instância
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_RATE=2.0

# Banco de dados local (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./zammad_noc.db

# Intervalo de sincronização automática com o Zammad (segundos)
SYNC_INTERVAL_SECONDS=60

# Janela de alerta de SLA (minutos antes do vencimento)
SLA_ALERT_MINUTES=15

# Ambiente: development | production
APP_ENV=development

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
